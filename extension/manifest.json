{
  "manifest_version": 3,
  "name": "Distill — Meet Capture",
  "version": "0.1.11",
  "description": "Capture per-participant Google Meet audio and stream it to Distill multi-stream meetings.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Distill",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": ["storage", "tabs", "scripting", "cookies"],
  "host_permissions": [
    "https://api.distill.app/*",
    "https://meet.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content/meet-bridge.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/meet-injected.js"],
      "matches": ["https://meet.google.com/*"]
    }
  ]
}
