# Distill local runtime (copy to runtime/.env)
# Full docs: docs/MODELS.md

# --- Hugging Face (optional — only needed to *download* gated pyannote) ---
# Also set on the server so vLLM can download LLM weights (avoids rate limits).
# Accept terms for:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
#   https://huggingface.co/pyannote/wespeaker-voxceleb-resnet34-LM
HF_TOKEN=

# --- LLM (vLLM) ---
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
VLLM_PORT=8001
VLLM_GPU_MEMORY_UTILIZATION=0.45
VLLM_MAX_MODEL_LEN=8192
VLLM_MAX_NUM_SEQS=8
LLM_GPU=0

# --- STT (faster-whisper) ---
# WHISPER_DEVICE selects the Docker image (cuda→Dockerfile.cuda, cpu→Dockerfile).
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
STT_PORT=8080
AUDIO_GPU=0

# --- Diarization (local sidecar) ---
# nemo | pyannote | auto
# Docker builds ONE stack: INSTALL_NEMO=1 → NeMo image; 0 → pyannote image
# DIARIZATION_DEVICE selects the Docker image (cuda→Dockerfile.cuda, cpu→Dockerfile).
DIARIZATION_BACKEND=nemo
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
DIARIZATION_DEVICE=cuda
# RTX 50xx (Blackwell / sm_120) needs the cu128 diarize image (Dockerfile.cuda).
# Older cu124 wheels crash with "no kernel image". If rebuild fails, use cpu.
DIARIZE_GPU=0
DIARIZE_PORT=8090
INSTALL_NEMO=1

LOG_LEVEL=INFO
