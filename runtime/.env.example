# Distill local runtime (copy to runtime/.env)

# --- Hugging Face (optional — only needed to *download* gated pyannote) ---
# Accept terms for:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
#   https://huggingface.co/pyannote/wespeaker-voxceleb-resnet34-LM
HF_TOKEN=

# --- LLM (vLLM) ---
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
VLLM_PORT=8001
VLLM_GPU_MEMORY_UTILIZATION=0.45
VLLM_MAX_MODEL_LEN=8192
VLLM_MAX_NUM_SEQS=8
LLM_GPU=0

# --- STT (faster-whisper) ---
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
STT_PORT=8080
AUDIO_GPU=0

# --- Diarization (local sidecar) ---
# auto | pyannote | nemo
# auto: offline pyannote → Hub (only if HF_TOKEN has gated access) → NeMo
DIARIZATION_BACKEND=auto
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
DIARIZATION_DEVICE=cpu
DIARIZE_PORT=8090
# Set to 1 when building diarize image without HF / offline pyannote weights:
INSTALL_NEMO=0

LOG_LEVEL=INFO
