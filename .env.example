# --- LLM ---
LLM_ENDPOINT="http://localhost:8000/v1/chat/completions"
LLM_API_KEY="sk-your-key"
LLM_MODEL_NAME="your-model-name"

# --- Audio ---
AUDIO_SAMPLE_RATE="16000"
AUDIO_CHANNELS="1"

# --- Meeting server ---
MEETING_HOST="0.0.0.0"
MEETING_PORT="8000"
MEETING_WINDOW_MS="8000"
MEETING_HOP_MS="6000"
MEETING_DIARIZE_EVERY_MS="20000"
# Set to 0 on small K8s pods to avoid loading torch/pyannote (OOM CrashLoop).
# DISTILL_ENABLE_PYANNOTE=1

# --- STT ---
STT_ENDPOINT="https://api.gapgpt.app/v1/audio/transcriptions"
STT_API_KEY=""
STT_MODEL="gapgpt/whisper-1"

# --- Diarization (optional, pyannote) ---
HF_TOKEN=""
