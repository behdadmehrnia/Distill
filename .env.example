# --- LLM ---
LLM_ENDPOINT="http://localhost:8000/v1/chat/completions"
LLM_API_KEY="sk-your-key"
LLM_MODEL_NAME="your-model-name"

# --- Audio ---
AUDIO_SAMPLE_RATE="16000"
AUDIO_CHANNELS="1"

# --- Meeting server ---
MEETING_HOST="0.0.0.0"
MEETING_PORT="8000"
MEETING_WINDOW_MS="8000"
MEETING_HOP_MS="6000"
MEETING_DIARIZE_EVERY_MS="20000"

# --- STT ---
STT_ENDPOINT="https://api.gapgpt.app/v1/audio/transcriptions"
STT_API_KEY=""
STT_MODEL="gapgpt/whisper-1"

# --- Diarization (optional, pyannote) ---
# In-process: set HF_TOKEN (+ optional requirements.optional.txt).
HF_TOKEN=""
# Remote sidecar (recommended for light `python -m api`):
#   cd diarize && docker compose up -d --build
# DIARIZATION_ENDPOINT="http://127.0.0.1:8090"
# DIARIZATION_TIMEOUT_S="120"
# With a remote endpoint, keep local torch off:
# DISTILL_ENABLE_PYANNOTE=0
# If huggingface.co is blocked (model download fails), use a mirror:
# HF_ENDPOINT=https://hf-mirror.com
