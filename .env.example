# How to run models: docs/MODELS.md
# Quick local / hybrid: docs/LOCAL_RUN.md
#
# Profiles:
#   diarize only → INSTALL_NEMO=1 docker compose -f diarize/docker-compose.yml up -d --build
#   STT+diarize  → ./runtime/scripts/start.sh --audio
#   full local   → ./runtime/scripts/start.sh  (then point LLM/STT below at :8001/:8080)

# --- LLM (cloud API keys OR local vLLM :8001) ---
# Native API (python -m api): use 127.0.0.1 below.
# API in Docker (root docker-compose.yml): use runtime service names:
#   LLM_ENDPOINT=http://llm:8000/v1/chat/completions
LLM_ENDPOINT="http://127.0.0.1:8001/v1/chat/completions"
LLM_API_KEY="local"
LLM_MODEL_NAME="Qwen/Qwen2.5-7B-Instruct"

# --- Audio ---
AUDIO_SAMPLE_RATE="16000"
AUDIO_CHANNELS="1"
# DeepFilterNet noise suppression on uploaded files (ONNX; see requirements.optional.txt)
AUDIO_DENOISE_UPLOAD="1"
# Cap suppression strength (dB); lower = gentler. Set to "none" to disable limiting.
AUDIO_DENOISE_ATTEN_LIM_DB="12"
# ONNX Runtime threads for upload denoise (default 1 matches Docker OMP settings)
# AUDIO_DENOISE_THREADS="1"

# --- Meeting server ---
MEETING_HOST="0.0.0.0"
MEETING_PORT="8000"
MEETING_WINDOW_MS="10000"
MEETING_HOP_MS="8500"
MEETING_DIARIZE_EVERY_MS="0"

# --- STT (local Whisper from runtime/) ---
# Docker API: STT_ENDPOINT=http://stt:8080/v1/audio/transcriptions
STT_ENDPOINT="http://127.0.0.1:8080/v1/audio/transcriptions"
STT_API_KEY="local"
STT_MODEL="large-v3"

# --- Diarization (always local sidecar — production) ---
# Start: ./runtime/scripts/start.sh   or   ./runtime/scripts/run_diarize.sh
# Docker API: DIARIZATION_ENDPOINT=http://diarize:8090
DIARIZATION_ENDPOINT="http://127.0.0.1:8090"
DIARIZATION_TIMEOUT_S="120"
# Fail loud instead of weak mono-mic heuristics when sidecar is down:
DIARIZATION_ALLOW_FALLBACK="0"
# Keep torch out of the API process when using the sidecar:
DISTILL_ENABLE_PYANNOTE="0"

# Optional: download gated pyannote weights once (offline thereafter):
#   ./runtime/scripts/download_models.sh
# HF_TOKEN only needed for that download (or Hub mode). Accept terms for:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
#   https://huggingface.co/pyannote/wespeaker-voxceleb-resnet34-LM
HF_TOKEN=""

# Sidecar backend (set in runtime/.env): auto | pyannote | nemo
# DIARIZATION_BACKEND=auto
